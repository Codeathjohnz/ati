# Copy this to ".env" next to docker-compose.yml (Dokploy's "Environment" tab
# for a Compose app writes exactly this file for you — paste these in there).

# --- Laravel ---------------------------------------------------------------
# Generate locally with: php artisan key:generate --show
APP_KEY=base64:REPLACE_ME

# Public URL of the backend API (used for links Laravel generates itself).
APP_URL=https://api.your-domain.com

# Public URL of the React frontend — must match exactly for CORS to allow it.
FRONTEND_URL=https://app.your-domain.com

# --- Database ----------------------------------------------------------------
DB_ROOT_PASSWORD=change_this_root_password
DB_DATABASE=ati_caraga
DB_USERNAME=ati
DB_PASSWORD=change_this_password

# --- Bootstrap admin account (seeded once, on first boot only) -------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ati-caraga.local
ADMIN_PASSWORD=change_this_before_going_live

# --- Frontend build arg ------------------------------------------------------
# The absolute URL the browser should call for the API, e.g.
# https://api.your-domain.com/api/v1. Baked in at BUILD time (Vite), so set
# this as a "build argument" in Dokploy for the frontend service — an env var
# alone here won't reach the browser bundle.
VITE_API_BASE_URL=https://api.your-domain.com/api/v1
